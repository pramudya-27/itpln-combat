---
import settings from '../data/settings.json';
import '../styles/hero.css';
---

<div class="hero">
  <!-- Efek Pendaran Cahaya & Kilatan Merah (Light Effect Burst) -->
  <div class="hero-light-effect" id="hero-light-effect" aria-hidden="true"></div>

  <!-- Komposisi Petir Utama ITPLN COMBAT: Petir Merah Bergetar + Sambaran Putih-Kemerahan + Percikan Listrik -->
  <div
    class="hero-lightning-container"
    id="hero-lightning-container"
    aria-hidden="true"
    role="img"
    title="Klik untuk menyambar ulang petir!"
  >
    <svg
      class="hero-lightning-svg"
      id="hero-lightning-svg"
      viewBox="0 0 460 700"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- Filter Cahaya Merah Neon (Light Effect Bloom) -->
        <filter id="neon-red-glow" x="-100%" y="-100%" width="300%" height="300%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur1" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="14" result="blur2" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="30" result="blur3" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="55" result="blur4" />
          <feMerge>
            <feMergeNode in="blur4" />
            <feMergeNode in="blur3" />
            <feMergeNode in="blur2" />
            <feMergeNode in="blur1" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- Gradien Petir Merah Utama -->
        <linearGradient id="redBoltGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#ff333d" />
          <stop offset="35%" stop-color="#e0161d" />
          <stop offset="70%" stop-color="#b01218" />
          <stop offset="100%" stop-color="#6b0a0e" />
        </linearGradient>

        <!-- Gradien Petir Putih Kemerahan Solid -->
        <linearGradient id="whiteRedGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="60%" stop-color="#ffffff" />
          <stop offset="85%" stop-color="#fff2f4" />
          <stop offset="100%" stop-color="#ffccd2" />
        </linearGradient>

        <!-- Gradien Sambaran Garis Listrik -->
        <linearGradient id="streakGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="45%" stop-color="#ff3845" />
          <stop offset="100%" stop-color="#e0161d" />
        </linearGradient>
      </defs>

      <!-- 1. Grup Petir Merah Besar (Muncul + Bergetar Hebat Saat Tersambar) -->
      <g class="bolt-red-group" id="bolt-red-group">
        <path
          class="bolt-red-body"
          id="bolt-red-body"
          d="M 207 0 L 460 0 L 276 315 L 460 315 L 0 700 L 175 385 L 0 385 Z"
          fill="url(#redBoltGrad)"
        />
        <path
          class="bolt-red-aura"
          id="bolt-red-aura"
          d="M 207 0 L 460 0 L 276 315 L 460 315 L 0 700 L 175 385 L 0 385 Z"
          fill="none"
          stroke="#ff2635"
          stroke-width="5"
          stroke-linejoin="miter"
          filter="url(#neon-red-glow)"
        />
      </g>

      <!-- 2. Petir Putih-Kemerahan (Bentuk SAMA PERSIS dengan Petir Merah, Tanpa Background Putih) -->
      <g class="white-red-strike-group" id="white-red-strike-group">
        <!-- Pendaran Neon Merah Elektrik mengikuti bentuk persis petir merah -->
        <path
          class="strike-outer-neon"
          d="M 207 0 L 460 0 L 276 315 L 460 315 L 0 700 L 175 385 L 0 385 Z"
          fill="none"
          stroke="#ff1e2b"
          stroke-width="16"
          stroke-linejoin="miter"
          filter="url(#neon-red-glow)"
          opacity="0.95"
        />
        <!-- Garis Petir Putih-Kemerahan Tajam (tanpa fill putih) -->
        <path
          class="strike-main-body"
          d="M 207 0 L 460 0 L 276 315 L 460 315 L 0 700 L 175 385 L 0 385 Z"
          fill="none"
          stroke="url(#whiteRedGrad)"
          stroke-width="6"
          stroke-linejoin="miter"
          filter="url(#neon-red-glow)"
        />
        <!-- Inti Kilat Putih Terang Menyambar di Tepian & Tengah Petir -->
        <path
          class="strike-pure-white-core"
          d="M 330 0 L 160 350 L 320 350 L 18 680"
          fill="none"
          stroke="#ffffff"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="miter"
          filter="url(#neon-red-glow)"
        />
        <!-- Sambaran Sinar Listrik Diagonal ke Bawah Kanan -->
        <path
          class="strike-discharge-streak"
          d="M 460 315 L 495 365 L 472 382 L 505 430"
          fill="none"
          stroke="url(#streakGrad)"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="miter"
          filter="url(#neon-red-glow)"
        />
      </g>

      <!-- 3. Percikan Listrik & Cabang Kilat (Electric Sparks) -->
      <g class="electric-sparks-group" id="electric-sparks-group" filter="url(#neon-red-glow)">
        <!-- Cabang kilat kecil menyebar -->
        <path class="spark-arc arc-1" d="M 305 210 L 245 185 L 220 205 L 185 180" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
        <path class="spark-arc arc-2" d="M 410 345 L 448 320 L 435 290 L 460 270" stroke="#ff5c66" stroke-width="2.5" stroke-linecap="round" />
        <path class="spark-arc arc-3" d="M 276 345 L 210 375 L 195 355 L 145 385" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
        <path class="spark-arc arc-4" d="M 290 515 L 225 545 L 210 580 L 170 605" stroke="#ff4d58" stroke-width="2.5" stroke-linecap="round" />

        <!-- Partikel percikan bunga api listrik beterbangan -->
        <circle class="spark-dot dot-1" cx="310" cy="210" r="4" fill="#ffffff" />
        <circle class="spark-dot dot-2" cx="405" cy="220" r="3.5" fill="#ff4d58" />
        <circle class="spark-dot dot-3" cx="278" cy="345" r="4.5" fill="#ffffff" />
        <circle class="spark-dot dot-4" cx="408" cy="350" r="4" fill="#ff3b47" />
        <circle class="spark-dot dot-5" cx="290" cy="512" r="4" fill="#ffffff" />
        <circle class="spark-dot dot-6" cx="365" cy="515" r="3.5" fill="#ff5c66" />
        <circle class="spark-dot dot-7" cx="240" cy="640" r="4.5" fill="#ffffff" />
        <circle class="spark-dot dot-8" cx="190" cy="385" r="3.5" fill="#ff3b47" />
      </g>
    </svg>
  </div>

  <div class="wrap">
    <h1>Tempa diri di <em>arena</em></h1>
    <p>
      UKM bela diri Institut Teknologi PLN. Muay Thai, Boxing, Tarung Derajat, dan MMA
      untuk mahasiswa yang mau lebih kuat, disiplin, dan berprestasi.
    </p>
    <div class="cta">
      <a
        class="btn"
        href={settings.link_form_daftar}
        target="_blank"
        rel="noopener noreferrer"
      >
        Daftar Anggota
      </a>
      <a class="btn ghost" href="/about">
        Tentang Kami
      </a>
    </div>
  </div>
</div>

<script is:inline>
  // Interaksi Parallax Kursor & Trigger Petir Menyambar Ulang
  const heroContainer = document.getElementById('hero-lightning-container');
  const heroFlash = document.getElementById('hero-light-effect');
  const boltRedGroup = document.getElementById('bolt-red-group');
  const strikeGroup = document.getElementById('white-red-strike-group');
  const sparksGroup = document.getElementById('electric-sparks-group');

  function retriggerLightningStrike() {
    const targets = [
      { el: heroFlash, anim: 'lightEffectBurst 1.3s cubic-bezier(0.1, 0.9, 0.2, 1) forwards' },
      { el: boltRedGroup, anim: 'redBoltImpactShake 1.1s cubic-bezier(0.2, 0.9, 0.3, 1) forwards' },
      { el: strikeGroup, anim: 'whiteRedStrikeAnim 1.3s cubic-bezier(0.15, 0.85, 0.2, 1) forwards' },
    ];

    targets.forEach(({ el }) => {
      if (el) el.style.animation = 'none';
    });

    if (sparksGroup) {
      sparksGroup.classList.remove('sparks-active');
      void sparksGroup.offsetWidth;
      sparksGroup.classList.add('sparks-active');
    }

    targets.forEach(({ el, anim }) => {
      if (el) {
        void el.offsetWidth;
        el.style.animation = anim;
      }
    });
  }

  if (sparksGroup) {
    sparksGroup.classList.add('sparks-active');
  }

  if (heroContainer) {
    window.addEventListener('mousemove', (e) => {
      if (window.innerWidth < 860) return;
      const x = e.clientX / window.innerWidth - 0.5;
      const y = e.clientY / window.innerHeight - 0.5;
      heroContainer.style.transform = `translateY(-50%) translate(${x * -24}px, ${y * -24}px) rotate(${x * 4}deg)`;
    });

    heroContainer.addEventListener('click', retriggerLightningStrike);
  }
</script>
