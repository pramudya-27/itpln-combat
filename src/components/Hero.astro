---
import settings from '../data/settings.json';
import '../styles/hero.css';
---

<div class="hero">
  <!-- Efek Pendaran Cahaya & Kilatan Merah Halus Tanpa Kotak -->
  <div class="hero-light-effect" id="hero-light-effect" aria-hidden="true"></div>

  <!-- Komposisi Petir Utama ITPLN COMBAT -->
  <div
    class="hero-lightning-container"
    id="hero-lightning-container"
    aria-hidden="true"
    role="img"
    title="Klik untuk menyambar ulang petir!"
  >
    <svg
      class="hero-lightning-svg"
      id="hero-lightning-svg"
      viewBox="-70 -70 600 840"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- Gradien Petir Merah Utama -->
        <linearGradient id="redBoltGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#ff333d" />
          <stop offset="35%" stop-color="#e0161d" />
          <stop offset="70%" stop-color="#b01218" />
          <stop offset="100%" stop-color="#6b0a0e" />
        </linearGradient>

        <!-- Gradien Garis Petir Putih Kemerahan -->
        <linearGradient id="whiteRedGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="55%" stop-color="#fff0f2" />
          <stop offset="100%" stop-color="#ff4d58" />
        </linearGradient>

        <!-- Gradien Sambaran Garis Listrik -->
        <linearGradient id="streakGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="45%" stop-color="#ff3845" />
          <stop offset="100%" stop-color="#e0161d" />
        </linearGradient>
      </defs>

      <!-- 1. Grup Petir Merah Besar (Muncul + Bergetar Saat Tersambar) -->
      <g class="bolt-red-group" id="bolt-red-group">
        <path
          class="bolt-red-body"
          id="bolt-red-body"
          d="M 207 0 L 460 0 L 276 315 L 460 315 L 0 700 L 175 385 L 0 385 Z"
          fill="url(#redBoltGrad)"
        />
        <path
          class="bolt-red-aura"
          id="bolt-red-aura"
          d="M 207 0 L 460 0 L 276 315 L 460 315 L 0 700 L 175 385 L 0 385 Z"
          fill="none"
          stroke="#ff2635"
          stroke-width="3.5"
          stroke-linejoin="miter"
        />
      </g>

      <!-- 2. Sambaran Petir Putih-Kemerahan (Murni Garis Stroke Tanpa Kotak Clip/Filter) -->
      <g class="white-red-strike-group" id="white-red-strike-group">
        <!-- Garis Aura Merah di Tepian Petir -->
        <path
          class="strike-stroke-path strike-outer-neon"
          pathLength="1000"
          d="M 207 0 L 460 0 L 276 315 L 460 315 L 0 700 L 175 385 L 0 385 Z"
          fill="none"
          stroke="#ff1e2b"
          stroke-width="10"
          stroke-linejoin="miter"
          opacity="0.7"
        />
        <!-- Garis Inti Putih-Kemerahan Menyambar Mengikuti Bentuk Petir -->
        <path
          class="strike-stroke-path strike-main-body"
          pathLength="1000"
          d="M 207 0 L 460 0 L 276 315 L 460 315 L 0 700 L 175 385 L 0 385 Z"
          fill="none"
          stroke="url(#whiteRedGrad)"
          stroke-width="4"
          stroke-linejoin="miter"
        />
        <!-- Kilatan Inti Tengah Petir -->
        <path
          class="strike-stroke-path strike-pure-white-core"
          pathLength="1000"
          d="M 330 6 L 165 348 L 325 348 L 16 686"
          fill="none"
          stroke="#ffffff"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="miter"
        />
        <!-- Sambaran Sinar Listrik Diagonal ke Bawah Kanan -->
        <path
          class="strike-discharge-streak"
          d="M 460 315 L 495 365 L 472 382 L 505 430"
          fill="none"
          stroke="url(#streakGrad)"
          stroke-width="3.5"
          stroke-linecap="round"
          stroke-linejoin="miter"
        />
      </g>

      <!-- 3. Percikan Listrik & Cabang Kilat (Electric Sparks) -->
      <g class="electric-sparks-group" id="electric-sparks-group">
        <path class="spark-arc arc-1" d="M 305 210 L 245 185 L 220 205 L 185 180" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" />
        <path class="spark-arc arc-2" d="M 410 345 L 448 320 L 435 290 L 465 268" stroke="#ff5c66" stroke-width="2.2" stroke-linecap="round" />
        <path class="spark-arc arc-3" d="M 276 345 L 210 375 L 195 355 L 145 385" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" />
        <path class="spark-arc arc-4" d="M 290 515 L 225 545 L 210 580 L 170 605" stroke="#ff4d58" stroke-width="2.2" stroke-linecap="round" />

        <circle class="spark-dot dot-1" cx="310" cy="210" r="3.5" fill="#ffffff" />
        <circle class="spark-dot dot-2" cx="405" cy="220" r="3" fill="#ff4d58" />
        <circle class="spark-dot dot-3" cx="278" cy="345" r="4" fill="#ffffff" />
        <circle class="spark-dot dot-4" cx="408" cy="350" r="3.5" fill="#ff3b47" />
        <circle class="spark-dot dot-5" cx="290" cy="512" r="3.5" fill="#ffffff" />
        <circle class="spark-dot dot-6" cx="365" cy="515" r="3" fill="#ff5c66" />
        <circle class="spark-dot dot-7" cx="240" cy="640" r="4" fill="#ffffff" />
        <circle class="spark-dot dot-8" cx="190" cy="385" r="3" fill="#ff3b47" />
      </g>
    </svg>
  </div>

  <div class="wrap">
    <h1>Tempa diri di <em>arena</em></h1>
    <p>
      UKM bela diri Institut Teknologi PLN. Muay Thai, Boxing, Tarung Derajat, dan MMA
      untuk mahasiswa yang mau lebih kuat, disiplin, dan berprestasi.
    </p>
    <div class="cta">
      <a
        class="btn"
        href={settings.link_form_daftar}
        target="_blank"
        rel="noopener noreferrer"
      >
        Daftar Anggota
      </a>
      <a class="btn ghost" href="/about">
        Tentang Kami
      </a>
    </div>
  </div>
</div>

<script is:inline>
  const heroContainer = document.getElementById('hero-lightning-container');
  const heroFlash = document.getElementById('hero-light-effect');
  const boltRedGroup = document.getElementById('bolt-red-group');
  const strikeGroup = document.getElementById('white-red-strike-group');
  const sparksGroup = document.getElementById('electric-sparks-group');

  function retriggerLightningStrike() {
    if (heroFlash) heroFlash.style.animation = 'none';
    if (boltRedGroup) boltRedGroup.style.animation = 'none';

    if (strikeGroup) {
      strikeGroup.classList.remove('strike-run');
      void strikeGroup.offsetWidth;
      strikeGroup.classList.add('strike-run');
    }

    if (sparksGroup) {
      sparksGroup.classList.remove('sparks-active');
      void sparksGroup.offsetWidth;
      sparksGroup.classList.add('sparks-active');
    }

    if (heroFlash) {
      void heroFlash.offsetWidth;
      heroFlash.style.animation = 'lightEffectBurst 1.2s cubic-bezier(0.1, 0.9, 0.2, 1) forwards';
    }
    if (boltRedGroup) {
      void boltRedGroup.offsetWidth;
      boltRedGroup.style.animation = 'redBoltImpactShake 1.05s cubic-bezier(0.2, 0.9, 0.3, 1) forwards';
    }
  }

  if (strikeGroup) strikeGroup.classList.add('strike-run');
  if (sparksGroup) sparksGroup.classList.add('sparks-active');

  if (heroContainer) {
    window.addEventListener('mousemove', (e) => {
      if (window.innerWidth < 860) return;
      const x = e.clientX / window.innerWidth - 0.5;
      const y = e.clientY / window.innerHeight - 0.5;
      heroContainer.style.transform = `translateY(-50%) translate(${x * -24}px, ${y * -24}px) rotate(${x * 4}deg)`;
    });

    heroContainer.addEventListener('click', retriggerLightningStrike);
  }
</script>
