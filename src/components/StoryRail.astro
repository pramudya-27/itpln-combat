---
import disciplinesData from '../data/disciplines.json';
import '../styles/storyrail.css';

const disciplines = disciplinesData.items || [];
const colors = ['#8f0c12', '#1a1a2e', '#5c0a0e', '#2b2b2f'];

function toSlug(disc) {
  if (disc.slug) return disc.slug;
  return String(disc.nama || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}
---

<section id="divisions">
  <div class="wrap">
    <div class="head">
      <div>
        <h2>Cabang latihan</h2>
        <p class="sub">
          Empat jenis cabang latihan bela diri di ITPLN COMBAT. Klik kartu untuk membaca penjelasan detail, fokus teknik, dan perlengkapan latihan.
        </p>
      </div>
    </div>

    <div class="rail" id="rail">
      {disciplines.map((disc, i) => {
        const slug = toSlug(disc);
        return (
          <a
            class="story rev"
            href={`/divisions/${slug}`}
            aria-label={`Lihat detail cabang ${disc.nama}`}
          >
            <div
              class="bg"
              style={`background: linear-gradient(135deg, ${colors[i % colors.length]}, #000);`}
            >
              {disc.foto && (
                <img
                  class="story-img"
                  src={disc.foto}
                  alt={disc.alt || `Cabang olahraga bela diri ${disc.nama} ITPLN COMBAT`}
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
              )}
            </div>

            <div class="mark" aria-hidden="true">
              {disc.nama.split(' ')[0]}
            </div>

            <div class="t">
              <span class="div-badge">Cabang Latihan</span>
              <h3>{disc.nama}</h3>
              <p>{disc.deskripsi}</p>
              <span class="div-link">
                Lihat Detail <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script is:inline>
  // Drag-to-scroll
  const rail = document.getElementById('rail');

  if (rail) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let draggedDistance = 0;

    rail.addEventListener('mousedown', (e) => {
      isDown = true;
      draggedDistance = 0;
      rail.style.scrollSnapType = 'none';
      rail.style.cursor = 'grabbing';
      startX = e.pageX - rail.offsetLeft;
      scrollLeft = rail.scrollLeft;
    });

    rail.addEventListener('mouseleave', () => {
      if (isDown) {
        isDown = false;
        rail.style.scrollSnapType = '';
        rail.style.cursor = 'grab';
      }
    });

    rail.addEventListener('mouseup', () => {
      if (isDown) {
        isDown = false;
        rail.style.scrollSnapType = '';
        rail.style.cursor = 'grab';
      }
    });

    rail.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - rail.offsetLeft;
      const walk = x - startX;
      draggedDistance = Math.abs(walk);
      rail.scrollLeft = scrollLeft - walk;
    });

    // Cegah klik tidak sengaja saat user sedang drag horizontal
    rail.querySelectorAll('a.story').forEach((link) => {
      link.addEventListener('click', (e) => {
        if (draggedDistance > 12) {
          e.preventDefault();
        }
      });
    });
  }
</script>
