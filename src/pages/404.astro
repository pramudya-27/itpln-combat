---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 – Halaman Tidak Ditemukan">
  <section class="min-h-[70vh] flex items-center justify-center">
    <div class="wrap text-center py-12">
      <h1 class="text-[clamp(90px,22vw,220px)] text-combat-red leading-none mb-2">
        404
      </h1>
      <h2 class="text-[clamp(26px,5vw,46px)] mt-2 mb-4">
        Halaman Tidak Ditemukan
      </h2>
      <p class="text-mute text-lg max-w-md mx-auto mb-8">
        Halaman yang kamu tuju tidak tersedia atau tautan sudah dipindahkan.
      </p>
      <a class="btn" href="/">
        Kembali ke Home
      </a>
    </div>
  </section>
</Layout>
