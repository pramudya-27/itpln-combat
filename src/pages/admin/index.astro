---
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Decap CMS – ITPLN COMBAT</title>
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Tahap 1: Tahan auto-init Decap CMS sampai login berhasil -->
    <script is:inline>
      window.CMS_MANUAL_INIT = true;
    </script>
    <style>
      :root {
        --a-bg: #070709;
        --a-surface: #101014;
        --a-elevated: #17171e;
        --a-border: #24242e;
        --a-text: #f4f4f6;
        --a-mute: #9494a3;
        --a-red: #e0161d;
        --a-red-hover: #ff2a32;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--a-bg);
        color: var(--a-text);
        font-family: Barlow, system-ui, -apple-system, sans-serif;
        min-height: 100vh;
      }

      body.cms-unlocked {
        background: #f4f5f7;
        color: #111;
        padding-top: 48px;
      }

      /* === LOGIN SCREEN === */
      .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background:
          radial-gradient(circle at 20% 20%, rgba(224, 22, 29, 0.16) 0%, transparent 45%),
          radial-gradient(circle at 80% 80%, rgba(143, 12, 18, 0.2) 0%, transparent 50%),
          var(--a-bg);
      }

      .login-card {
        width: 100%;
        max-width: 420px;
        background: var(--a-surface);
        border: 1px solid var(--a-border);
        border-top: 3px solid var(--a-red);
        border-radius: 12px;
        padding: 36px 32px;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75);
      }

      .login-logo {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        display: block;
        margin: 0 auto 16px;
        box-shadow: 0 0 32px rgba(224, 22, 29, 0.45);
      }

      .login-title {
        font-family: Anton, sans-serif;
        font-size: 32px;
        letter-spacing: 0.04em;
        text-align: center;
        margin: 0;
        color: #fff;
      }

      .login-sub {
        text-align: center;
        color: var(--a-mute);
        font-size: 14px;
        margin: 6px 0 28px;
      }

      .field-group { margin-bottom: 18px; }

      .field-label {
        display: block;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #c8c8d4;
        margin-bottom: 7px;
      }

      .a-input {
        width: 100%;
        background: var(--a-elevated);
        border: 1px solid var(--a-border);
        border-radius: 8px;
        color: #fff;
        font-family: Barlow, sans-serif;
        font-size: 15px;
        padding: 11px 14px;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
      }

      .a-input:focus {
        border-color: var(--a-red);
        box-shadow: 0 0 0 3px rgba(224, 22, 29, 0.2);
      }

      .pw-wrap { position: relative; }

      .pw-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--a-mute);
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        padding: 4px 6px;
      }

      .pw-toggle:hover { color: #fff; }

      .a-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 8px;
        font-family: "Barlow Condensed", sans-serif;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.2s ease;
        background: var(--a-red);
        color: #fff;
        width: 100%;
      }

      .a-btn:hover {
        background: var(--a-red-hover);
        box-shadow: 0 6px 20px rgba(224, 22, 29, 0.35);
      }

      .login-err {
        background: rgba(239, 68, 68, 0.14);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #fca5a5;
        font-size: 14px;
        padding: 10px 12px;
        border-radius: 8px;
        margin-bottom: 16px;
        display: none;
      }

      /* === DECAP CMS TOP BAR === */
      .decap-top-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 48px;
        background: #0a0a0d;
        border-bottom: 2px solid var(--a-red);
        color: #fff;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
      }

      .decap-top-bar.visible {
        display: flex;
      }

      .decap-top-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: Anton, sans-serif;
        font-size: 17px;
        letter-spacing: 0.05em;
      }

      .decap-top-brand img {
        width: 28px;
        height: 28px;
        border-radius: 50%;
      }

      .decap-bar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .decap-bar-btn {
        background: #17171f;
        border: 1px solid #2e2e3a;
        color: #fff;
        font-family: "Barlow Condensed", sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.18s;
      }

      .decap-bar-btn:hover {
        background: var(--a-red);
        border-color: var(--a-red);
      }
    </style>
  </head>

  <body>
    <!-- 1. HALAMAN LOGIN ADMIN (/admin) -->
    <div id="login-screen" class="login-shell">
      <div class="login-card">
        <img src="/logo.webp" alt="Logo ITPLN COMBAT" class="login-logo" />
        <h1 class="login-title">ADMIN LOGIN</h1>
        <p class="login-sub">Masuk untuk membuka Decap CMS ITPLN COMBAT</p>

        <div id="login-error" class="login-err"></div>

        <form id="login-form" autocomplete="on">
          <div class="field-group">
            <label for="login-user" class="field-label">Username</label>
            <input
              id="login-user"
              type="text"
              class="a-input"
              placeholder="Masukkan username"
              required
              autocomplete="username"
            />
          </div>

          <div class="field-group">
            <label for="login-pass" class="field-label">Password</label>
            <div class="pw-wrap">
              <input
                id="login-pass"
                type="password"
                class="a-input"
                placeholder="Masukkan password"
                required
                autocomplete="current-password"
                style="padding-right: 68px;"
              />
              <button type="button" id="pw-toggle" class="pw-toggle">Lihat</button>
            </div>
          </div>

          <button type="submit" class="a-btn" style="margin-top: 6px;">
            Masuk ke Decap CMS
          </button>
        </form>

        <div style="text-align: center; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--a-border);">
          <a href="/" style="color: var(--a-mute); font-size: 13.5px; text-decoration: none;">
            ← Kembali ke Website Utama
          </a>
        </div>
      </div>
    </div>

    <!-- 2. TOP BAR & MOUNT POINT DECAP CMS -->
    <div id="decap-top-bar" class="decap-top-bar">
      <div class="decap-top-brand">
        <img src="/logo.webp" alt="Logo ITPLN COMBAT" />
        <span>ITPLN COMBAT • DECAP CMS</span>
        <span style="font-family: Barlow, sans-serif; font-size: 12px; font-weight: 600; color: #9494a3; background: #17171f; border: 1px solid #2e2e3a; padding: 3px 9px; border-radius: 4px;">
          ☁️ Cloudinary: dkrxyn8i5 (Maks 2–3 MB / Foto)
        </span>
      </div>
      <div class="decap-bar-actions">
        <a href="/" class="decap-bar-btn">← Kembali ke Website</a>
        <button type="button" id="btn-logout" class="decap-bar-btn">Logout</button>
      </div>
    </div>

    <div id="nc-root"></div>

    <!-- Decap CMS Core (Manual Init) -->
    <script src="https://unpkg.com/decap-cms@3.3.3/dist/decap-cms.js" is:inline></script>

    <script is:inline>
      const SESSION_KEY = 'itpln_combat_decap_session';
      const FALLBACK_CRED_HASH = 'e1a6f516711bcac6ebf25a773574441f9fdc1a9cc1297f9667c1f2b2ddee03c3';
      let cmsInitialized = false;

      async function sha256Hex(str) {
        const data = new TextEncoder().encode(str);
        const hashBuf = await crypto.subtle.digest('SHA-256', data);
        return Array.from(new Uint8Array(hashBuf))
          .map((b) => b.toString(16).padStart(2, '0'))
          .join('');
      }

      function launchDecapCMS() {
        document.getElementById('login-screen').style.display = 'none';
        document.getElementById('decap-top-bar').classList.add('visible');
        document.body.classList.add('cms-unlocked');

        if (cmsInitialized) return;
        cmsInitialized = true;

        const proxyUrl = window.location.origin + '/api/v1';

        window.CMS.init({
          config: {
            load_config_file: false,
            backend: {
              name: 'proxy',
              proxy_url: proxyUrl,
              branch: 'main',
            },
            locale: 'id',
            media_folder: 'public/uploads',
            public_folder: '/uploads',
            site_url: window.location.origin,
            display_url: window.location.origin,
            logo_url: '/logo.webp',
            collections: [
              {
                name: 'news',
                label: 'News (Kabar & Berita)',
                label_singular: 'Berita',
                folder: 'src/content/news',
                create: true,
                slug: '{{slug}}',
                extension: 'md',
                format: 'frontmatter',
                summary: '{{title}} — [{{category}}] • Status: {{status}} ({{startDate}})',
                sortable_fields: ['startDate', 'publishDate', 'title', 'category', 'status'],
                fields: [
                  { label: 'Judul Berita', name: 'title', widget: 'string', required: true },
                  { label: 'Slug URL', name: 'customSlug', widget: 'string', required: false },
                  { label: 'Deskripsi Singkat', name: 'description', widget: 'text', required: true },
                  {
                    label: 'Featured Image',
                    name: 'featuredImage',
                    widget: 'image',
                    media_folder: '/public/uploads/news',
                    public_folder: '/uploads/news',
                    media_library: {
                      config: {
                        max_file_size: 3145728,
                      },
                    },
                    hint: 'Aturan Upload: Maksimal 2–3 MB per foto (JPG/PNG/WEBP). Masuk ke Cloudinary (dkrxyn8i5) folder itpln-combat/news.',
                    required: true,
                  },
                  { label: 'Alt Text Gambar', name: 'imageAlt', widget: 'string', default: 'Dokumentasi Berita ITPLN COMBAT', required: true },
                  {
                    label: 'Kategori Berita',
                    name: 'category',
                    widget: 'select',
                    options: ['Kegiatan', 'Pertandingan', 'Latihan', 'Pengumuman', 'Prestasi'],
                    default: 'Kegiatan',
                    required: true,
                  },
                  { label: 'Penulis', name: 'author', widget: 'string', default: 'Tim Humas ITPLN COMBAT', required: true },
                  {
                    label: 'Tanggal Mulai Berita (startDate - WIB)',
                    name: 'startDate',
                    widget: 'datetime',
                    format: 'YYYY-MM-DDTHH:mm:ss',
                    date_format: 'YYYY-MM-DD',
                    time_format: 'HH:mm',
                    required: true,
                  },
                  {
                    label: 'Tanggal Berakhir Berita (endDate - WIB)',
                    name: 'endDate',
                    widget: 'datetime',
                    format: 'YYYY-MM-DDTHH:mm:ss',
                    date_format: 'YYYY-MM-DD',
                    time_format: 'HH:mm',
                    required: false,
                  },
                  {
                    label: 'Tanggal Publikasi',
                    name: 'publishDate',
                    widget: 'datetime',
                    format: 'YYYY-MM-DDTHH:mm:ss',
                    date_format: 'YYYY-MM-DD',
                    time_format: 'HH:mm',
                    required: false,
                  },
                  {
                    label: 'Status Publikasi',
                    name: 'status',
                    widget: 'select',
                    options: ['Published', 'Draft'],
                    default: 'Published',
                    required: true,
                  },
                  { label: 'Featured (Berita Sorotan)', name: 'featured', widget: 'boolean', default: false, required: false },
                  { label: 'Isi Berita Lengkap (Markdown)', name: 'body', widget: 'markdown', required: true },
                ],
              },
              {
                name: 'gallery',
                label: 'Gallery (Dokumentasi Foto)',
                label_singular: 'Foto Galeri',
                folder: 'src/content/gallery',
                create: true,
                slug: '{{slug}}',
                extension: 'json',
                format: 'json',
                identifier_field: 'title',
                summary: '#{{order}} {{title}} — [{{category}}] ({{status}})',
                sortable_fields: ['order', 'date', 'title', 'category', 'status'],
                fields: [
                  { label: 'Judul Foto', name: 'title', widget: 'string', required: true },
                  { label: 'Deskripsi Kegiatan', name: 'description', widget: 'text', required: true },
                  {
                    label: 'Gambar',
                    name: 'image',
                    widget: 'image',
                    media_folder: '/public/uploads/gallery',
                    public_folder: '/uploads/gallery',
                    media_library: {
                      config: {
                        max_file_size: 3145728,
                      },
                    },
                    hint: 'Aturan Upload: Maksimal 2–3 MB per foto (JPG/PNG/WEBP). Masuk ke Cloudinary (dkrxyn8i5) folder itpln-combat/gallery.',
                    required: true,
                  },
                  { label: 'Alt Text Gambar', name: 'alt', widget: 'string', required: true },
                  {
                    label: 'Kategori Kegiatan',
                    name: 'category',
                    widget: 'select',
                    options: ['Muay Thai', 'Boxing', 'Tarung Derajat', 'MMA', 'Training', 'Competition', 'Events'],
                    default: 'Training',
                    required: true,
                  },
                  {
                    label: 'Tanggal Kegiatan',
                    name: 'date',
                    widget: 'datetime',
                    format: 'YYYY-MM-DD',
                    date_format: 'YYYY-MM-DD',
                    time_format: false,
                    required: true,
                  },
                  { label: 'Featured Image', name: 'featured', widget: 'boolean', default: false, required: false },
                  { label: 'Urutan Tampilan', name: 'order', widget: 'number', value_type: 'int', default: 1, min: 1, required: true },
                  { label: 'Status Publikasi', name: 'status', widget: 'select', options: ['Published', 'Draft'], default: 'Published', required: true },
                ],
              },
            ],
          },
        });
      }

      // Toggle Lihat/Tutup Password
      const pwToggle = document.getElementById('pw-toggle');
      const pwInput = document.getElementById('login-pass');
      if (pwToggle && pwInput) {
        pwToggle.addEventListener('click', () => {
          const hidden = pwInput.type === 'password';
          pwInput.type = hidden ? 'text' : 'password';
          pwToggle.textContent = hidden ? 'Tutup' : 'Lihat';
        });
      }

      // Login Submit Handler
      const loginForm = document.getElementById('login-form');
      const loginErr = document.getElementById('login-error');
      if (loginForm) {
        loginForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          loginErr.style.display = 'none';

          const username = document.getElementById('login-user').value.trim();
          const password = document.getElementById('login-pass').value;

          try {
            const res = await fetch('/api/admin/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ username, password }),
            });
            if (res.ok) {
              const json = await res.json();
              if (json.success && json.token) {
                sessionStorage.setItem(SESSION_KEY, json.token);
                launchDecapCMS();
                return;
              }
            } else if (res.status === 401) {
              throw new Error('INVALID_CRED');
            }
          } catch (err) {
            if (err.message === 'INVALID_CRED') {
              loginErr.textContent = 'Username atau password salah.';
              loginErr.style.display = 'block';
              return;
            }
          }

          // Fallback SHA-256 verification (Netlify static / serverless)
          const digest = await sha256Hex(`${username}:${password}`);
          if (digest === FALLBACK_CRED_HASH) {
            sessionStorage.setItem(SESSION_KEY, digest);
            launchDecapCMS();
          } else {
            loginErr.textContent = 'Username atau password salah.';
            loginErr.style.display = 'block';
          }
        });
      }

      // Logout
      document.getElementById('btn-logout')?.addEventListener('click', () => {
        sessionStorage.removeItem(SESSION_KEY);
        window.location.reload();
      });

      // Auto-launch Decap CMS jika sesi login masih aktif
      if (sessionStorage.getItem(SESSION_KEY)) {
        launchDecapCMS();
      }

      // Validasi Ketat Ukuran Upload Foto di Admin (Maksimal 3 MB per foto)
      const MAX_UPLOAD_BYTES = 3 * 1024 * 1024;
      document.addEventListener(
        'change',
        (e) => {
          const input = e.target;
          if (input && input.tagName === 'INPUT' && input.type === 'file' && input.files?.length) {
            for (const file of input.files) {
              if (file.size > MAX_UPLOAD_BYTES) {
                const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                alert(
                  `Ukuran foto "${file.name}" (${sizeMb} MB) melebihi batas maksimal 3 MB!\n\nAturan Upload Admin: Maksimal 2–3 MB per foto. Silakan pilih atau kompres foto terlebih dahulu.`
                );
                input.value = '';
                e.stopImmediatePropagation();
                e.preventDefault();
                return false;
              }
            }
          }
        },
        true
      );
    </script>
  </body>
</html>
