---
import '../../styles/global.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel – ITPLN COMBAT</title>
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --a-bg: #070709;
        --a-surface: #101014;
        --a-elevated: #17171e;
        --a-border: #24242e;
        --a-border-hover: #383847;
        --a-text: #f4f4f6;
        --a-mute: #9494a3;
        --a-red: #e0161d;
        --a-red-hover: #ff2a32;
        --a-green: #22c55e;
        --a-yellow: #eab308;
        --a-coral: #ef4444;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--a-bg);
        color: var(--a-text);
        font-family: Barlow, system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* === LOGIN SCREEN === */
      .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background:
          radial-gradient(circle at 20% 20%, rgba(224, 22, 29, 0.16) 0%, transparent 45%),
          radial-gradient(circle at 80% 80%, rgba(143, 12, 18, 0.2) 0%, transparent 50%),
          var(--a-bg);
      }

      .login-card {
        width: 100%;
        max-width: 420px;
        background: var(--a-surface);
        border: 1px solid var(--a-border);
        border-top: 3px solid var(--a-red);
        border-radius: 12px;
        padding: 36px 32px;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75);
      }

      .login-logo {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        display: block;
        margin: 0 auto 16px;
        box-shadow: 0 0 32px rgba(224, 22, 29, 0.45);
      }

      .login-title {
        font-family: Anton, sans-serif;
        font-size: 32px;
        letter-spacing: 0.04em;
        text-align: center;
        margin: 0;
        color: #fff;
      }

      .login-sub {
        text-align: center;
        color: var(--a-mute);
        font-size: 14px;
        margin: 6px 0 28px;
      }

      .field-group {
        margin-bottom: 18px;
      }

      .field-label {
        display: block;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #c8c8d4;
        margin-bottom: 7px;
      }

      .a-input, .a-select, .a-textarea {
        width: 100%;
        background: var(--a-elevated);
        border: 1px solid var(--a-border);
        border-radius: 8px;
        color: #fff;
        font-family: Barlow, sans-serif;
        font-size: 15px;
        padding: 11px 14px;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
      }

      .a-input:focus, .a-select:focus, .a-textarea:focus {
        border-color: var(--a-red);
        box-shadow: 0 0 0 3px rgba(224, 22, 29, 0.2);
      }

      .a-textarea {
        resize: vertical;
        min-height: 92px;
      }

      .pw-wrap {
        position: relative;
      }

      .pw-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--a-mute);
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        padding: 4px 6px;
      }

      .pw-toggle:hover { color: #fff; }

      .a-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 8px;
        font-family: "Barlow Condensed", sans-serif;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .a-btn-primary {
        background: var(--a-red);
        color: #fff;
      }

      .a-btn-primary:hover {
        background: var(--a-red-hover);
        box-shadow: 0 6px 20px rgba(224, 22, 29, 0.35);
      }

      .a-btn-secondary {
        background: var(--a-elevated);
        border-color: var(--a-border);
        color: #e4e4ec;
      }

      .a-btn-secondary:hover {
        border-color: var(--a-border-hover);
        background: #20202a;
        color: #fff;
      }

      .a-btn-danger {
        background: rgba(239, 68, 68, 0.14);
        border-color: rgba(239, 68, 68, 0.35);
        color: #f87171;
      }

      .a-btn-danger:hover {
        background: #ef4444;
        color: #fff;
      }

      .a-btn-sm {
        padding: 7px 13px;
        font-size: 13px;
        border-radius: 6px;
      }

      .login-err {
        background: rgba(239, 68, 68, 0.14);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #fca5a5;
        font-size: 14px;
        padding: 10px 12px;
        border-radius: 8px;
        margin-bottom: 16px;
        display: none;
      }

      /* === DASHBOARD SHELL === */
      .admin-shell {
        display: none;
        min-height: 100vh;
      }

      .admin-shell.active {
        display: flex;
      }

      .sidebar {
        width: 264px;
        flex-shrink: 0;
        background: var(--a-surface);
        border-right: 1px solid var(--a-border);
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 40;
        transition: transform 0.25s ease;
      }

      .sb-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px;
        border-bottom: 1px solid var(--a-border);
      }

      .sb-brand img {
        width: 38px;
        height: 38px;
        border-radius: 50%;
      }

      .sb-brand-title {
        font-family: Anton, sans-serif;
        font-size: 20px;
        letter-spacing: 0.04em;
        line-height: 1;
        color: #fff;
      }

      .sb-brand-sub {
        font-size: 11px;
        color: var(--a-red-hover);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-top: 3px;
      }

      .sb-nav {
        padding: 16px 12px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
        overflow-y: auto;
      }

      .sb-section-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #656575;
        padding: 12px 12px 6px;
      }

      .sb-item {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 11px 14px;
        border-radius: 8px;
        background: transparent;
        border: 1px solid transparent;
        color: #b4b4c2;
        font-size: 14.5px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.18s ease;
        text-align: left;
      }

      .sb-item:hover {
        background: var(--a-elevated);
        color: #fff;
      }

      .sb-item.active {
        background: rgba(224, 22, 29, 0.14);
        border-color: rgba(224, 22, 29, 0.38);
        color: #fff;
      }

      .sb-item .sb-left {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .sb-badge {
        font-size: 12px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 999px;
        background: var(--a-elevated);
        color: #d4d4df;
      }

      .sb-item.active .sb-badge {
        background: var(--a-red);
        color: #fff;
      }

      .sb-footer {
        padding: 14px 12px;
        border-top: 1px solid var(--a-border);
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      /* Main Area */
      .main-area {
        flex: 1;
        margin-left: 264px;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 30;
        height: 64px;
        background: rgba(7, 7, 9, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--a-border);
        padding: 0 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .topbar-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .mobile-menu-btn {
        display: none;
        background: var(--a-elevated);
        border: 1px solid var(--a-border);
        color: #fff;
        padding: 7px 11px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 700;
      }

      .topbar-title {
        font-family: Anton, sans-serif;
        font-size: 22px;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        margin: 0;
      }

      .topbar-right {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .wib-clock {
        font-size: 13px;
        color: var(--a-mute);
        background: var(--a-surface);
        border: 1px solid var(--a-border);
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: 500;
      }

      .content-body {
        padding: 28px;
        max-width: 1380px;
        width: 100%;
      }

      .tab-panel { display: none; }
      .tab-panel.active { display: block; }

      /* KPI Cards */
      .kpi-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
      }

      .kpi-card {
        background: var(--a-surface);
        border: 1px solid var(--a-border);
        border-radius: 10px;
        padding: 18px;
        position: relative;
        overflow: hidden;
      }

      .kpi-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--kpi-accent, var(--a-red));
      }

      .kpi-label {
        font-family: "Barlow Condensed", sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--a-mute);
      }

      .kpi-val {
        font-family: Anton, sans-serif;
        font-size: 38px;
        line-height: 1.1;
        margin-top: 8px;
        color: #fff;
      }

      .kpi-sub {
        font-size: 12px;
        color: #707082;
        margin-top: 4px;
      }

      /* Surface Panels */
      .panel-card {
        background: var(--a-surface);
        border: 1px solid var(--a-border);
        border-radius: 12px;
        padding: 22px;
      }

      .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
      }

      .panel-title {
        font-family: "Barlow Condensed", sans-serif;
        font-size: 20px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0;
        color: #fff;
      }

      /* Empty State */
      .empty-state {
        border: 1px dashed var(--a-border-hover);
        background: rgba(23, 23, 30, 0.5);
        border-radius: 10px;
        padding: 40px 24px;
        text-align: center;
      }

      .empty-state h4 {
        font-family: "Barlow Condensed", sans-serif;
        font-size: 22px;
        margin: 8px 0 6px;
        color: #fff;
      }

      .empty-state p {
        color: var(--a-mute);
        font-size: 14px;
        margin: 0 0 18px;
        max-width: 440px;
        margin-inline: auto;
      }

      /* Status Pills */
      .st-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 999px;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .st-active { background: rgba(34, 197, 94, 0.14); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.35); }
      .st-upcoming { background: rgba(234, 179, 8, 0.14); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.35); }
      .st-expired { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.38); }
      .st-draft { background: rgba(148, 163, 184, 0.14); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.3); }

      /* News Item Row Card */
      .news-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .news-row {
        display: flex;
        align-items: center;
        gap: 16px;
        background: var(--a-elevated);
        border: 1px solid var(--a-border);
        border-radius: 10px;
        padding: 14px;
        transition: border-color 0.2s;
      }

      .news-row:hover { border-color: var(--a-border-hover); }

      .news-thumb {
        width: 112px;
        height: 74px;
        border-radius: 6px;
        object-fit: cover;
        background: #0a0a0d;
        flex-shrink: 0;
        border: 1px solid var(--a-border);
      }

      .news-row-info {
        flex: 1;
        min-width: 0;
      }

      .news-row-title {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin: 4px 0;
      }

      .news-row-meta {
        font-size: 12.5px;
        color: var(--a-mute);
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      /* Gallery Admin Grid */
      .gal-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 16px;
      }

      .gal-card {
        background: var(--a-elevated);
        border: 1px solid var(--a-border);
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      .gal-card-img-wrap {
        position: relative;
        aspect-ratio: 16 / 10;
        background: #09090c;
        overflow: hidden;
      }

      .gal-card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .gal-card-body {
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
      }

      /* Modal Editor */
      .editor-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.78);
        backdrop-filter: blur(6px);
        z-index: 80;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        overflow-y: auto;
      }

      .editor-backdrop.open {
        display: flex;
      }

      .editor-dialog {
        width: 100%;
        max-width: 720px;
        max-height: 90vh;
        overflow-y: auto;
        background: var(--a-surface);
        border: 1px solid var(--a-border);
        border-top: 3px solid var(--a-red);
        border-radius: 12px;
        padding: 24px 26px;
        box-shadow: 0 28px 80px rgba(0, 0, 0, 0.85);
      }

      .editor-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      .upload-box {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--a-elevated);
        border: 1px dashed var(--a-border-hover);
        border-radius: 8px;
        padding: 12px;
      }

      .upload-preview {
        width: 96px;
        height: 64px;
        border-radius: 6px;
        object-fit: cover;
        background: #0a0a0c;
        border: 1px solid var(--a-border);
        flex-shrink: 0;
      }

      /* Toast */
      .toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 100;
        background: #14141b;
        border: 1px solid var(--a-border);
        border-left: 4px solid var(--a-green);
        color: #fff;
        padding: 13px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
        transform: translateY(120px);
        opacity: 0;
        transition: all 0.25s ease;
      }

      .toast.show {
        transform: translateY(0);
        opacity: 1;
      }

      .toast.error {
        border-left-color: var(--a-coral);
      }

      @media (max-width: 1180px) {
        .kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }

      @media (max-width: 900px) {
        .sidebar { transform: translateX(-100%); }
        .sidebar.open { transform: translateX(0); }
        .main-area { margin-left: 0; }
        .mobile-menu-btn { display: inline-flex; }
        .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .editor-grid-2 { grid-template-columns: 1fr; }
        .news-row { flex-direction: column; align-items: flex-start; }
        .news-thumb { width: 100%; height: 160px; }
        .wib-clock { display: none; }
      }
    </style>
  </head>

  <body>
    <!-- ==================== 1. LOGIN SCREEN ==================== -->
    <div id="login-screen" class="login-shell">
      <div class="login-card">
        <img src="/logo.webp" alt="Logo ITPLN COMBAT" class="login-logo" />
        <h1 class="login-title">ADMIN PORTAL</h1>
        <p class="login-sub">Masuk untuk mengelola News, Gallery &amp; Konten ITPLN COMBAT</p>

        <div id="login-error" class="login-err"></div>

        <form id="login-form" autocomplete="on">
          <div class="field-group">
            <label for="login-user" class="field-label">Username</label>
            <input
              id="login-user"
              type="text"
              class="a-input"
              placeholder="Masukkan username"
              required
              autocomplete="username"
            />
          </div>

          <div class="field-group">
            <label for="login-pass" class="field-label">Password</label>
            <div class="pw-wrap">
              <input
                id="login-pass"
                type="password"
                class="a-input"
                placeholder="Masukkan password"
                required
                autocomplete="current-password"
                style="padding-right: 68px;"
              />
              <button type="button" id="pw-toggle" class="pw-toggle">Lihat</button>
            </div>
          </div>

          <button type="submit" id="login-submit" class="a-btn a-btn-primary" style="width: 100%; margin-top: 6px;">
            Masuk ke Dashboard
          </button>
        </form>

        <div style="text-align: center; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--a-border);">
          <a href="/" style="color: var(--a-mute); font-size: 13.5px; text-decoration: none;">
            ← Kembali ke Website Utama
          </a>
        </div>
      </div>
    </div>

    <!-- ==================== 2. ADMIN DASHBOARD APP ==================== -->
    <div id="admin-app" class="admin-shell">
      <!-- Sidebar Navigasi -->
      <aside id="admin-sidebar" class="sidebar">
        <div class="sb-brand">
          <img src="/logo.webp" alt="ITPLN COMBAT" />
          <div>
            <div class="sb-brand-title">ITPLN COMBAT</div>
            <div class="sb-brand-sub">Admin Control Panel</div>
          </div>
        </div>

        <nav class="sb-nav">
          <div class="sb-section-label">Utama</div>
          <button type="button" class="sb-item active" data-tab="overview">
            <span class="sb-left">📊 Dashboard Overview</span>
          </button>

          <div class="sb-section-label">Manajemen Konten</div>
          <button type="button" class="sb-item" data-tab="news">
            <span class="sb-left">📰 Kelola News</span>
            <span class="sb-badge" id="nav-count-news">0</span>
          </button>
          <button type="button" class="sb-item" data-tab="gallery">
            <span class="sb-left">📷 Kelola Gallery</span>
            <span class="sb-badge" id="nav-count-gallery">0</span>
          </button>
          <button type="button" class="sb-item" data-tab="about">
            <span class="sb-left">📋 Profil UKM</span>
          </button>
          <button type="button" class="sb-item" data-tab="settings">
            <span class="sb-left">⚙️ Pengaturan &amp; Link</span>
          </button>

          <div class="sb-section-label">GitHub CMS Sync</div>
          <a href="/cms/" class="sb-item">
            <span class="sb-left">🔗 Buka Decap CMS</span>
            <span style="font-size: 12px;">↗</span>
          </a>
        </nav>

        <div class="sb-footer">
          <a href="/" class="a-btn a-btn-secondary a-btn-sm" style="width: 100%;">
            ← Kembali ke Website
          </a>
          <button type="button" id="btn-logout" class="a-btn a-btn-danger a-btn-sm" style="width: 100%;">
            Logout (Keluar)
          </button>
        </div>
      </aside>

      <!-- Workspace Utama -->
      <div class="main-area">
        <header class="topbar">
          <div class="topbar-left">
            <button type="button" id="mobile-menu-btn" class="mobile-menu-btn">☰ Menu</button>
            <h2 class="topbar-title" id="topbar-title">Dashboard Overview</h2>
          </div>

          <div class="topbar-right">
            <div class="wib-clock" id="wib-clock">WIB • Asia/Jakarta</div>
            <button type="button" id="quick-add-news" class="a-btn a-btn-primary a-btn-sm">
              + Berita Baru
            </button>
          </div>
        </header>

        <div class="content-body">
          <!-- ========== TAB 1: OVERVIEW ========== -->
          <section id="tab-overview" class="tab-panel active">
            <!-- 6 KPI Cards Real Data -->
            <div class="kpi-grid">
              <div class="kpi-card" style="--kpi-accent: #ffffff;">
                <div class="kpi-label">Total Berita</div>
                <div class="kpi-val" id="kpi-total-news">0</div>
                <div class="kpi-sub">Semua artikel</div>
              </div>
