    <!-- Toast Notification -->
    <div id="admin-toast" class="toast">Berhasil disimpan!</div>

    <script is:inline>
      // ================================================================
      // ITPLN COMBAT ADMIN ENGINE (Login + Live CRUD + Asia/Jakarta WIB)
      // ================================================================
      const SESSION_KEY = 'itpln_combat_admin_token';
      const LOCAL_STORE_KEY = 'itpln_combat_dynamic_content';
      // SHA-256 hash untuk fallback static preview
      const FALLBACK_CRED_HASH = 'e1a6f516711bcac6ebf25a773574441f9fdc1a9cc1297f9667c1f2b2ddee03c3';

      let authToken = sessionStorage.getItem(SESSION_KEY) || '';
      let state = { news: [], gallery: [], about: {}, settings: {}, disciplines: [] };
      let apiAvailable = true;

      // Utility: Toast
      let toastTimer;
      function showToast(msg, isErr = false) {
        const el = document.getElementById('admin-toast');
        if (!el) return;
        el.textContent = msg;
        el.className = 'toast show' + (isErr ? ' error' : '');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => el.classList.remove('show'), 3200);
      }

      // Utility: SHA-256 Hex
      async function sha256Hex(str) {
        const data = new TextEncoder().encode(str);
        const hashBuf = await crypto.subtle.digest('SHA-256', data);
        return Array.from(new Uint8Array(hashBuf))
          .map((b) => b.toString(16).padStart(2, '0'))
          .join('');
      }

      // Utility: Parse tanggal dengan zona waktu Asia/Jakarta (+07:00)
      function parseWIB(raw, isEnd) {
        if (!raw) return null;
        const s = String(raw).trim();
        if (!s) return null;
        if (/^\d{4}-\d{2}-\d{2}$/.test(s)) {
          return Date.parse(s + (isEnd ? 'T23:59:59.999+07:00' : 'T00:00:00.000+07:00'));
        }
        const norm = s.replace(/^(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2})/, '$1T$2');
        const hasTz = /([Zz]|[+-]\d{2}:?\d{2})$/.test(norm);
        const ms = Date.parse(hasTz ? norm : norm + '+07:00');
        return Number.isNaN(ms) ? null : ms;
      }

      function computeStatus(item) {
        if (String(item.status || 'Published').toLowerCase() === 'draft') return 'Draft';
        const now = Date.now();
        const startMs = parseWIB(item.startDate, false);
        const endMs = parseWIB(item.endDate, true);
        if (startMs !== null && now < startMs) return 'Upcoming';
        if (endMs !== null && now > endMs) return 'Expired';
        return 'Active';
      }

      function statusBadgeHtml(st) {
        if (st === 'Active') return '<span class="st-pill st-active">● ACTIVE</span>';
        if (st === 'Upcoming') return '<span class="st-pill st-upcoming">● UPCOMING</span>';
        if (st === 'Expired') return '<span class="st-pill st-expired">● EXPIRED</span>';
        return '<span class="st-pill st-draft">● DRAFT</span>';
      }

      function slugify(str) {
        return String(str || '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');
      }

      function escHtml(s) {
        return String(s || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      // Jam Real-Time WIB
      function updateClock() {
        const el = document.getElementById('wib-clock');
        if (!el) return;
        const formatted = new Intl.DateTimeFormat('id-ID', {
          timeZone: 'Asia/Jakarta',
          day: 'numeric',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
        }).format(new Date());
        el.textContent = formatted + ' WIB';
      }
      setInterval(updateClock, 1000);
      updateClock();

      // ==================== LOGIN HANDLER ====================
      const loginForm = document.getElementById('login-form');
      const loginErr = document.getElementById('login-error');
      const pwToggle = document.getElementById('pw-toggle');
      const pwInput = document.getElementById('login-pass');

      if (pwToggle && pwInput) {
        pwToggle.addEventListener('click', () => {
          const hidden = pwInput.type === 'password';
          pwInput.type = hidden ? 'text' : 'password';
          pwToggle.textContent = hidden ? 'Tutup' : 'Lihat';
        });
      }

      if (loginForm) {
        loginForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (loginErr) loginErr.style.display = 'none';

          const username = document.getElementById('login-user').value.trim();
          const password = document.getElementById('login-pass').value;

          try {
            const res = await fetch('/api/admin/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ username, password }),
            });

            if (res.ok) {
              const json = await res.json();
              if (json.success && json.token) {
                authToken = json.token;
                sessionStorage.setItem(SESSION_KEY, authToken);
                enterDashboard();
                return;
              }
            } else if (res.status === 401) {
              throw new Error('Username atau password salah.');
            } else {
              throw new Error('API_FALLBACK');
            }
          } catch (err) {
            if (err.message === 'Username atau password salah.') {
              loginErr.textContent = err.message;
              loginErr.style.display = 'block';
              return;
            }
            // Fallback static hosting verification via SHA-256
            const digest = await sha256Hex(`${username}:${password}`);
            if (digest === FALLBACK_CRED_HASH) {
              apiAvailable = false;
              authToken = 'static-session-' + digest.slice(0, 16);
              sessionStorage.setItem(SESSION_KEY, authToken);
              enterDashboard();
              return;
            } else {
              loginErr.textContent = 'Username atau password salah.';
              loginErr.style.display = 'block';
            }
          }
        });
      }

      document.getElementById('btn-logout')?.addEventListener('click', () => {
        sessionStorage.removeItem(SESSION_KEY);
        authToken = '';
        document.getElementById('admin-app').classList.remove('active');
        document.getElementById('login-screen').style.display = 'flex';
        showToast('Anda telah keluar dari Admin Panel.');
      });

      function enterDashboard() {
        document.getElementById('login-screen').style.display = 'none';
        document.getElementById('admin-app').classList.add('active');
        loadAllData();
      }

      // ==================== LOAD & SYNC CONTENT ====================
      async function loadAllData() {
        try {
          const res = await fetch('/api/admin/content');
          if (res.ok) {
            const json = await res.json();
            if (json.success && json.data) {
              apiAvailable = true;
              state = json.data;
              renderAll();
              return;
            }
          }
        } catch {}

        // Fallback baca dari localStorage bila berjalan tanpa dev server
        apiAvailable = false;
        const saved = localStorage.getItem(LOCAL_STORE_KEY);
        if (saved) {
          try { state = JSON.parse(saved); } catch {}
        }
        renderAll();
      }

      function saveLocalFallback() {
        localStorage.setItem(LOCAL_STORE_KEY, JSON.stringify(state));
      }

      // ==================== RENDER ALL VIEWS ====================
      function renderAll() {
        const news = state.news || [];
        const gallery = state.gallery || [];

        let pub = 0, act = 0, upc = 0, exp = 0;
        news.forEach((n) => {
          const st = computeStatus(n);
          if (st !== 'Draft') pub++;
          if (st === 'Active') act++;
          if (st === 'Upcoming') upc++;
          if (st === 'Expired') exp++;
        });

        document.getElementById('kpi-total-news').textContent = String(news.length);
        document.getElementById('kpi-pub-news').textContent = String(pub);
        document.getElementById('kpi-act-news').textContent = String(act);
        document.getElementById('kpi-upc-news').textContent = String(upc);
        document.getElementById('kpi-exp-news').textContent = String(exp);
        document.getElementById('kpi-total-gal').textContent = String(gallery.length);

        document.getElementById('nav-count-news').textContent = String(news.length);
        document.getElementById('nav-count-gallery').textContent = String(gallery.length);

        renderOverviewLists();
        renderNewsManager();
        renderGalleryManager();
        populateAboutAndSettings();
      }

      function renderOverviewLists() {
        const newsWrap = document.getElementById('overview-news-list');
        const galWrap = document.getElementById('overview-gallery-list');
        const news = (state.news || []).slice(0, 4);
        const gallery = (state.gallery || []).slice(0, 4);

        if (!news.length) {
          newsWrap.innerHTML = `
            <div class="empty-state">
              <div style="font-size: 30px;">📰</div>
              <h4>Belum Ada Berita</h4>
              <p>Data berita masih kosong (bebas data dummy). Klik tombol di bawah untuk membuat berita resmi pertama.</p>
              <button type="button" class="a-btn a-btn-primary a-btn-sm" onclick="openNewsModal()">+ Buat Berita Pertama</button>
            </div>`;
        } else {
          newsWrap.innerHTML = `<div class="news-list">${news
            .map((n) => {
              const st = computeStatus(n);
              return `
                <div class="news-row" style="padding: 10px 12px;">
                  <img src="${escHtml(n.featuredImage || '/logo.webp')}" class="news-thumb" style="width: 68px; height: 48px;" onerror="this.src='/logo.webp'" />
                  <div class="news-row-info">
                    <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                      ${statusBadgeHtml(st)}
                      <span style="font-size:11px; color:#f87171; font-weight:700; text-transform:uppercase;">${escHtml(n.category)}</span>
                    </div>
                    <div class="news-row-title" style="font-size:14.5px;">${escHtml(n.title)}</div>
                  </div>
                </div>`;
            })
            .join('')}</div>`;
        }

        if (!gallery.length) {
          galWrap.innerHTML = `
            <div class="empty-state">
              <div style="font-size: 30px;">📷</div>
              <h4>Belum Ada Foto Galeri</h4>
              <p>Galeri masih bersih tanpa data dummy. Mulai unggah dokumentasi latihan atau pertandingan ITPLN COMBAT.</p>
              <button type="button" class="a-btn a-btn-primary a-btn-sm" onclick="openGalleryModal()">+ Upload Foto Pertama</button>
            </div>`;
        } else {
          galWrap.innerHTML = `<div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:10px;">${gallery
            .map(
              (g) => `
              <div class="gal-card">
                <div class="gal-card-img-wrap">
                  <img src="${escHtml(g.image)}" alt="${escHtml(g.alt)}" onerror="this.src='/logo.webp'" />
                </div>
                <div style="padding:8px 10px;">
                  <div style="font-size:11px; color:#f87171; font-weight:700; text-transform:uppercase;">${escHtml(g.category)}</div>
                  <div style="font-size:13px; font-weight:700; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escHtml(g.title)}</div>
                </div>
              </div>`
            )
            .join('')}</div>`;
        }
      }

      function renderNewsManager() {
        const container = document.getElementById('news-manager-list');
        const filter = document.getElementById('news-status-filter')?.value || 'ALL';
        const items = (state.news || []).filter((n) => filter === 'ALL' || computeStatus(n) === filter);

        if (!items.length) {
          container.innerHTML = `
            <div class="empty-state">
              <div style="font-size: 34px;">📝</div>
              <h4>Belum Ada Berita ${filter !== 'ALL' ? 'berstatus ' + filter : ''}</h4>
              <p>Tambahkan berita baru lengkap dengan gambar, jadwal tayang WIB, dan konten Markdown.</p>
              <button type="button" class="a-btn a-btn-primary" onclick="openNewsModal()">+ Tambah Berita Baru</button>
            </div>`;
          return;
        }

        container.innerHTML = items
          .map((n) => {
            const st = computeStatus(n);
            return `
              <div class="news-row">
                <img src="${escHtml(n.featuredImage || '/logo.webp')}" alt="${escHtml(n.title)}" class="news-thumb" onerror="this.src='/logo.webp'" />
                <div class="news-row-info">
                  <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px;">
                    ${statusBadgeHtml(st)}
                    <span style="font-size:12px; font-weight:700; color:#f87171; text-transform:uppercase;">${escHtml(n.category)}</span>
                    ${n.featured ? '<span style="font-size:11px; background:rgba(255,255,255,0.1); padding:2px 7px; border-radius:4px;">★ Featured</span>' : ''}
                  </div>
                  <div class="news-row-title">${escHtml(n.title)}</div>
                  <div class="news-row-meta">
                    <span>Mulai: ${escHtml(n.startDate || '-')}</span>
                    <span>Selesai: ${escHtml(n.endDate || 'Tanpa Batas')}</span>
                    <span>Penulis: ${escHtml(n.author)}</span>
                  </div>
                </div>
                <div style="display:flex; gap:8px; flex-shrink:0;">
                  <button type="button" class="a-btn a-btn-secondary a-btn-sm" onclick="editNews('${escHtml(n.fileSlug || n.slug)}')">Edit</button>
                  <button type="button" class="a-btn a-btn-danger a-btn-sm" onclick="deleteNews('${escHtml(n.fileSlug || n.slug)}')">Hapus</button>
                </div>
              </div>`;
          })
          .join('');
      }

      function renderGalleryManager() {
        const container = document.getElementById('gallery-manager-grid');
        const filter = document.getElementById('gallery-cat-filter')?.value || 'ALL';
        const items = (state.gallery || []).filter((g) => filter === 'ALL' || g.category === filter);

        if (!items.length) {
          container.innerHTML = `
            <div class="empty-state" style="grid-column: 1 / -1;">
              <div style="font-size: 34px;">🖼️</div>
              <h4>Belum Ada Foto Galeri ${filter !== 'ALL' ? 'di Kategori ' + filter : ''}</h4>
              <p>Unggah foto latihan, kompetisi, atau kegiatan UKM untuk langsung ditampilkan di halaman Gallery.</p>
              <button type="button" class="a-btn a-btn-primary" onclick="openGalleryModal()">+ Upload Foto Galeri</button>
            </div>`;
          return;
        }

        container.innerHTML = items
          .map(
            (g) => `
            <div class="gal-card">
              <div class="gal-card-img-wrap">
                <img src="${escHtml(g.image)}" alt="${escHtml(g.alt)}" onerror="this.src='/logo.webp'" />
                <span style="position:absolute; top:8px; left:8px; background:rgba(0,0,0,0.8); color:#fff; font-size:11px; font-weight:700; padding:2px 8px; border-radius:4px;">#${g.order}</span>
                ${g.featured ? '<span style="position:absolute; top:8px; right:8px; background:var(--a-red); color:#fff; font-size:11px; font-weight:700; padding:2px 8px; border-radius:4px;">★ Featured</span>' : ''}
              </div>
              <div class="gal-card-body">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:6px;">
                  <span style="font-size:11.5px; font-weight:700; color:#f87171; text-transform:uppercase;">${escHtml(g.category)}</span>
                  <span style="font-size:11.5px; color:var(--a-mute);">${escHtml(g.date)}</span>
                </div>
                <div style="font-size:15px; font-weight:700; color:#fff;">${escHtml(g.title)}</div>
                <div style="font-size:13px; color:var(--a-mute); flex:1;">${escHtml(g.description)}</div>
                <div style="display:flex; gap:8px; margin-top:6px;">
                  <button type="button" class="a-btn a-btn-secondary a-btn-sm" style="flex:1;" onclick="editGallery('${escHtml(g.id)}')">Edit</button>
                  <button type="button" class="a-btn a-btn-danger a-btn-sm" onclick="deleteGallery('${escHtml(g.id)}')">Hapus</button>
                </div>
              </div>
            </div>`
          )
          .join('');
      }

      // ==================== TAB SWITCHING ====================
      const tabTitles = {
        overview: 'Dashboard Overview',
        news: 'Kelola News & Artikel',
        gallery: 'Kelola Galeri Foto',
        about: 'Profil UKM & Jadwal Latihan',
        settings: 'Pengaturan & Tautan Resmi',
      };

      window.switchTab = function (tabName) {
        document.querySelectorAll('.tab-panel').forEach((p) => p.classList.remove('active'));
        document.querySelectorAll('.sb-item[data-tab]').forEach((b) => b.classList.remove('active'));
        document.getElementById('tab-' + tabName)?.classList.add('active');
        document.querySelector(`.sb-item[data-tab="${tabName}"]`)?.classList.add('active');
        document.getElementById('topbar-title').textContent = tabTitles[tabName] || 'Admin Panel';
        document.getElementById('admin-sidebar').classList.remove('open');
      };

      document.querySelectorAll('.sb-item[data-tab]').forEach((btn) => {
        btn.addEventListener('click', () => window.switchTab(btn.dataset.tab));
      });

      document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
        document.getElementById('admin-sidebar').classList.toggle('open');
      });

      document.getElementById('quick-add-news')?.addEventListener('click', () => window.openNewsModal());
      document.getElementById('news-status-filter')?.addEventListener('change', renderNewsManager);
      document.getElementById('gallery-cat-filter')?.addEventListener('change', renderGalleryManager);

      // ==================== IMAGE UPLOAD HELPER ====================
      async function handleImageFileUpload(fileInput, urlInput, previewImg, folder) {
        const file = fileInput.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = async () => {
          const dataUrl = reader.result;
          previewImg.src = dataUrl;
          if (apiAvailable) {
            try {
              const res = await fetch('/api/admin/upload', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  Authorization: 'Bearer ' + authToken,
                },
                body: JSON.stringify({ folder, filename: file.name, dataUrl }),
              });
              const json = await res.json();
              if (json.success && json.url) {
                urlInput.value = json.url;
                previewImg.src = json.url;
                showToast('Gambar berhasil diunggah ke ' + json.url);
                return;
              }
            } catch {}
          }
          // Static fallback: simpan dataUrl langsung
          urlInput.value = dataUrl;
          showToast('Gambar dimuat ke pratinjau lokal.');
        };
        reader.readAsDataURL(file);
      }

      document.getElementById('nf-img-file')?.addEventListener('change', (e) => {
        handleImageFileUpload(
          e.target,
          document.getElementById('nf-img-url'),
          document.getElementById('nf-img-preview'),
          'news'
        );
      });
      document.getElementById('nf-img-url')?.addEventListener('input', (e) => {
        document.getElementById('nf-img-preview').src = e.target.value || '/logo.webp';
      });

      document.getElementById('gf-img-file')?.addEventListener('change', (e) => {
        handleImageFileUpload(
          e.target,
          document.getElementById('gf-img-url'),
          document.getElementById('gf-img-preview'),
          'gallery'
        );
      });
      document.getElementById('gf-img-url')?.addEventListener('input', (e) => {
        document.getElementById('gf-img-preview').src = e.target.value || '/logo.webp';
      });

      // Auto-generate slug dari judul berita
      document.getElementById('nf-title')?.addEventListener('input', (e) => {
        const oldSlug = document.getElementById('nf-old-slug').value;
        if (!oldSlug) {
          document.getElementById('nf-slug').value = slugify(e.target.value);
        }
      });

      // ==================== NEWS CRUD ====================
      window.openNewsModal = function (item = null) {
        const modal = document.getElementById('news-editor-modal');
        document.getElementById('news-editor-title').textContent = item ? 'Edit Berita' : 'Tambah Berita Baru';
        document.getElementById('nf-old-slug').value = item ? item.fileSlug || item.slug : '';
        document.getElementById('nf-title').value = item ? item.title : '';
        document.getElementById('nf-slug').value = item ? item.slug : '';
        document.getElementById('nf-category').value = item ? item.category : 'Kegiatan';
        document.getElementById('nf-author').value = item ? item.author : 'Tim Humas ITPLN COMBAT';
        document.getElementById('nf-img-url').value = item ? item.featuredImage : '';
        document.getElementById('nf-img-preview').src = item?.featuredImage || '/logo.webp';
        document.getElementById('nf-img-alt').value = item ? item.imageAlt : '';
        document.getElementById('nf-img-file').value = '';

        const nowLocal = new Date(Date.now() + 7 * 3600 * 1000).toISOString().slice(0, 16);
        document.getElementById('nf-start').value = item?.startDate ? item.startDate.slice(0, 16) : nowLocal;
        document.getElementById('nf-end').value = item?.endDate ? item.endDate.slice(0, 16) : '';
        document.getElementById('nf-status').value = item ? item.status : 'Published';
        document.getElementById('nf-featured').checked = Boolean(item?.featured);
        document.getElementById('nf-desc').value = item ? item.description : '';
        document.getElementById('nf-body').value = item ? item.body : '';

        modal.classList.add('open');
      };

      window.closeNewsModal = function () {
        document.getElementById('news-editor-modal').classList.remove('open');
      };

      window.editNews = function (slug) {
        const item = (state.news || []).find((n) => (n.fileSlug || n.slug) === slug);
        if (item) window.openNewsModal(item);
      };

      window.deleteNews = async function (slug) {
        if (!confirm('Hapus berita ini secara permanen?')) return;
        if (apiAvailable) {
          const res = await fetch('/api/admin/news/' + encodeURIComponent(slug), {
            method: 'DELETE',
            headers: { Authorization: 'Bearer ' + authToken },
          });
          if (res.ok) {
            showToast('Berita berhasil dihapus.');
            await loadAllData();
            return;
          }
        }
        state.news = (state.news || []).filter((n) => (n.fileSlug || n.slug) !== slug);
        saveLocalFallback();
        renderAll();
        showToast('Berita dihapus.');
      };

      document.getElementById('news-editor-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          oldFileSlug: document.getElementById('nf-old-slug').value || undefined,
          title: document.getElementById('nf-title').value.trim(),
          customSlug: document.getElementById('nf-slug').value.trim() || slugify(document.getElementById('nf-title').value),
          category: document.getElementById('nf-category').value,
          author: document.getElementById('nf-author').value.trim(),
          featuredImage: document.getElementById('nf-img-url').value.trim(),
          imageAlt: document.getElementById('nf-img-alt').value.trim() || document.getElementById('nf-title').value.trim(),
          startDate: document.getElementById('nf-start').value + ':00',
          endDate: document.getElementById('nf-end').value ? document.getElementById('nf-end').value + ':00' : '',
          publishDate: document.getElementById('nf-start').value + ':00',
          status: document.getElementById('nf-status').value,
          featured: document.getElementById('nf-featured').checked,
          description: document.getElementById('nf-desc').value.trim(),
          body: document.getElementById('nf-body').value.trim(),
        };

        if (apiAvailable) {
          const res = await fetch('/api/admin/news', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: 'Bearer ' + authToken,
            },
            body: JSON.stringify(payload),
          });
          const json = await res.json();
          if (json.success) {
            window.closeNewsModal();
            showToast('Berita berhasil disimpan ke src/content/news/!');
            await loadAllData();
            return;
          } else {
            showToast(json.error || 'Gagal menyimpan berita.', true);
            return;
          }
        }

        // Fallback static mode
        state.news = (state.news || []).filter((n) => (n.fileSlug || n.slug) !== payload.oldFileSlug && n.slug !== payload.customSlug);
        state.news.unshift({ ...payload, fileSlug: payload.customSlug, slug: payload.customSlug });
        saveLocalFallback();
        window.closeNewsModal();
        renderAll();
        showToast('Berita disimpan secara dinamis!');
      });

      // ==================== GALLERY CRUD ====================
      window.openGalleryModal = function (item = null) {
        const modal = document.getElementById('gallery-editor-modal');
        document.getElementById('gallery-editor-title').textContent = item ? 'Edit Foto Galeri' : 'Upload Foto Galeri';
        document.getElementById('gf-old-id').value = item ? item.id : '';
        document.getElementById('gf-img-url').value = item ? item.image : '';
        document.getElementById('gf-img-preview').src = item?.image || '/logo.webp';
        document.getElementById('gf-img-file').value = '';
        document.getElementById('gf-title').value = item ? item.title : '';
        document.getElementById('gf-category').value = item ? item.category : 'Training';
        document.getElementById('gf-desc').value = item ? item.description : '';
        document.getElementById('gf-alt').value = item ? item.alt : '';
        document.getElementById('gf-date').value = item?.date || new Date().toISOString().slice(0, 10);
        document.getElementById('gf-order').value = item ? item.order : (state.gallery?.length || 0) + 1;
        document.getElementById('gf-status').value = item ? item.status : 'Published';
        document.getElementById('gf-featured').checked = Boolean(item?.featured);
        modal.classList.add('open');
      };

      window.closeGalleryModal = function () {
        document.getElementById('gallery-editor-modal').classList.remove('open');
      };

      window.editGallery = function (id) {
        const item = (state.gallery || []).find((g) => g.id === id);
        if (item) window.openGalleryModal(item);
      };

      window.deleteGallery = async function (id) {
        if (!confirm('Hapus foto ini dari galeri?')) return;
        if (apiAvailable) {
          const res = await fetch('/api/admin/gallery/' + encodeURIComponent(id), {
            method: 'DELETE',
            headers: { Authorization: 'Bearer ' + authToken },
          });
          if (res.ok) {
            showToast('Foto galeri berhasil dihapus.');
            await loadAllData();
            return;
          }
        }
        state.gallery = (state.gallery || []).filter((g) => g.id !== id);
        saveLocalFallback();
        renderAll();
        showToast('Foto dihapus.');
      };

      document.getElementById('gallery-editor-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const title = document.getElementById('gf-title').value.trim();
        const payload = {
          oldId: document.getElementById('gf-old-id').value || undefined,
          id: document.getElementById('gf-old-id').value || slugify(title) + '-' + Date.now().toString().slice(-4),
          title,
          image: document.getElementById('gf-img-url').value.trim(),
          category: document.getElementById('gf-category').value,
          description: document.getElementById('gf-desc').value.trim(),
          alt: document.getElementById('gf-alt').value.trim() || title,
          date: document.getElementById('gf-date').value,
          order: Number(document.getElementById('gf-order').value) || 1,
          status: document.getElementById('gf-status').value,
          featured: document.getElementById('gf-featured').checked,
        };

        if (apiAvailable) {
          const res = await fetch('/api/admin/gallery', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: 'Bearer ' + authToken,
            },
            body: JSON.stringify(payload),
          });
          const json = await res.json();
          if (json.success) {
            window.closeGalleryModal();
            showToast('Foto galeri berhasil disimpan ke src/content/gallery/!');
            await loadAllData();
            return;
          } else {
            showToast(json.error || 'Gagal menyimpan foto.', true);
            return;
          }
        }

        state.gallery = (state.gallery || []).filter((g) => g.id !== payload.oldId && g.id !== payload.id);
        state.gallery.push(payload);
        saveLocalFallback();
        window.closeGalleryModal();
        renderAll();
        showToast('Foto galeri disimpan secara dinamis!');
      });

      // ==================== PROFIL & PENGATURAN ====================
      function populateAboutAndSettings() {
        const ab = state.about || {};
        document.getElementById('ab-tentang').value = ab.tentang || '';
        document.getElementById('ab-visi').value = ab.visi || '';
        document.getElementById('ab-misi').value = ab.misi || '';
        document.getElementById('ab-syarat').value = ab.syarat || '';

        const st = state.settings || {};
        document.getElementById('st-daftar').value = st.link_form_daftar || '';
        document.getElementById('st-merch').value = st.link_form_merch || '';
        document.getElementById('st-ig').value = st.instagram_url || '';
        document.getElementById('st-email').value = st.email || '';
      }

      document.getElementById('about-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          ...(state.about || {}),
          tentang: document.getElementById('ab-tentang').value.trim(),
          visi: document.getElementById('ab-visi').value.trim(),
          misi: document.getElementById('ab-misi').value.trim(),
          syarat: document.getElementById('ab-syarat').value.trim(),
          jadwal: {
            items: [
              { hari: 'Rabu', waktu: '19:00 - 21:00', tempat: 'Loby Depan' },
              { hari: 'Sabtu', waktu: '19:00 - 21:00', tempat: 'Loby Depan' },
            ],
          },
        };
        if (apiAvailable) {
          const res = await fetch('/api/admin/about', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + authToken },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            showToast('Profil UKM berhasil disimpan!');
            await loadAllData();
            return;
          }
        }
        state.about = payload;
        saveLocalFallback();
        showToast('Profil UKM tersimpan.');
      });

      document.getElementById('settings-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          ...(state.settings || {}),
          link_form_daftar: document.getElementById('st-daftar').value.trim(),
          link_form_merch: document.getElementById('st-merch').value.trim(),
          instagram_url: document.getElementById('st-ig').value.trim(),
          email: document.getElementById('st-email').value.trim(),
        };
        if (apiAvailable) {
          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + authToken },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            showToast('Pengaturan & link formulir berhasil disimpan!');
            await loadAllData();
            return;
          }
        }
        state.settings = payload;
        saveLocalFallback();
        showToast('Pengaturan tersimpan.');
      });

      // Tutup modal dengan tombol Esc
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          window.closeNewsModal();
          window.closeGalleryModal();
        }
      });

      // Boot check
      if (authToken) {
        enterDashboard();
      }
    </script>
  </body>
</html>
